# MyDaily Production Environment Variables (Backend)
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=generate-a-strong-random-key-here-for-production
DJANGO_ALLOWED_HOSTS=mydaily.local,localhost,127.0.0.1,0.0.0.0,*

# CORS - Comma separated domains allowed to make API requests (e.g. https://mydaily.app)
# Leave blank or set CORS_ALLOW_ALL=True if running behind a unified reverse proxy
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_ALL=False

# SSL / HTTPS (Enable if deploying directly with HTTPS certificates)
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0

# Database
SQLITE_DB_NAME=db.sqlite3

# Logging Level (INFO, WARNING, ERROR, DEBUG)
DJANGO_LOG_LEVEL=INFO

