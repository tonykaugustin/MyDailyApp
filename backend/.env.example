# MyDaily Production Environment Variables (Backend)
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=generate-a-strong-random-key-here-for-production
DJANGO_ALLOWED_HOSTS=mydaily.local,localhost,127.0.0.1,0.0.0.0,*

# CORS
CORS_ALLOW_ALL=True

# Database (MySQL / SQLite)
DB_ENGINE=mysql
DB_NAME=mydailyapp
DB_USER=root
DB_PASSWORD=1012
DB_HOST=127.0.0.1
DB_PORT=3306

# Logging Level (INFO, WARNING, ERROR, DEBUG)
DJANGO_LOG_LEVEL=INFO
